ADDR=:8080

# Motor de base de datos: mysql (MariaDB, por defecto) o libsql (Bunny Database,
# Turso, sqld). Con libsql el esquema se crea solo al arrancar.
DB_DRIVER=mysql

# MariaDB (DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=typsteditor
DB_USER=typsteditor
DB_PASSWORD=cambiar_esta_clave

# libSQL (DB_DRIVER=libsql). Si faltan, se usan BUNNY_DATABASE_URL y
# BUNNY_DATABASE_AUTH_TOKEN (las que inyecta Magic Containers).
# DB_URL=libsql://<id-de-la-base>.lite.bunnydb.net
# DB_AUTH_TOKEN=

# Genera uno con: ./bin/server key:generate  (o go run . key:generate)
JWT_SECRET=
TOKEN_TTL=8h

# Solo se usa para crear el primer administrador si no existe ninguno.
# ADMIN_EMAIL también se asigna al administrador ADMIN_USER si aún no tiene
# correo (instalaciones anteriores al inicio de sesión por correo).
ADMIN_USER=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Correo saliente con Resend (https://resend.com): altas de usuarios (enlace
# para definir la contraseña), «olvidé mi contraseña», confirmar el correo,
# invitaciones a proyectos y avisos. RESEND es la clave de la API (también se
# acepta RESEND_API_KEY). MAIL_FROM debe ser de un dominio verificado en
# Resend; con el de pruebas (onboarding@resend.dev) Resend solo entrega al
# correo del dueño de la cuenta. Sin clave no se envía nada y los enlaces se
# muestran a quien crea el usuario o la invitación, para copiarlos.
# Los enlaces de los correos usan PUBLIC_URL: en producción debe ser la URL real.
RESEND=
MAIL_FROM=nullpointer editor <onboarding@resend.dev>
# MAIL_ENABLED=false desactiva el correo aunque haya clave (p. ej. si Resend
# no responde). Sin correo, las cuentas nuevas (que siguen necesitando su
# correo) se activan con una contraseña temporal que el administrador ve una
# sola vez y entrega; al iniciar sesión hay que cambiarla antes de seguir.
# «Restablecer acceso» genera otra. Las invitaciones a proyectos muestran el
# enlace para copiarlo.
MAIL_ENABLED=true

# Directorio de datos: cada proyecto es un repositorio git en DATA_DIR/projects/<id>
DATA_DIR=data
# Binarios del sistema
TYPST_BIN=typst
GIT_BIN=git
# API de GitHub (cámbiala para GitHub Enterprise: https://<host>/api/v3)
GITHUB_API=https://api.github.com
# Frontend compilado que sirve este mismo servidor. Si se deja vacío usa
# public/ junto al ejecutable (build.sh) o, si no existe, ../frontend/dist.
# Si no encuentra index.html, solo se sirve la API.
STATIC_DIR=
# Fuentes para typst, además de las del sistema: siempre se usan fonts/ del
# repositorio (Roboto) y DATA_DIR/fonts (fuentes locales o con licencia, p. ej.
# Calibri; se detectan sin reiniciar). FONT_PATHS añade más carpetas,
# separadas por «:».
FONT_PATHS=

# URL pública del servidor, sin barra final (emisor OAuth y recurso MCP:
# PUBLIC_URL/mcp). Por defecto http://localhost:<puerto de ADDR>. Para usarlo
# como conector personalizado de Claude o ChatGPT debe ser https y accesible
# desde internet (en desarrollo, p. ej., un túnel de cloudflared).
PUBLIC_URL=
# Servidor MCP (/mcp) y servidor de autorización OAuth 2.1 (/oauth/*).
MCP_ENABLED=true
